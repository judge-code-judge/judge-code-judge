Task: 76 | TIMEOUT: Execution exceeded limit
(n 이 1,0 일떄 무한루프)
public boolean isSimplePower(int x, int n) {
    int i = 1;
    while (i <= x) {
        if (i == x) {
            return true;
        }
        i *= n;
    }
    return false;
}

